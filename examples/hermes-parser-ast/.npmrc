# install-links: hermes-parser is a "file:" dependency
# (../../external/hermes-parser-native/package). npm's default
# (install-links=false) symlinks file: dependencies instead of copying them.
# Node then resolves further requires from inside that package via the
# symlink's real path -- which is outside this directory -- so its own
# dependency (hermes-estree) is not found there even though it is declared
# and installed here. install-links=true makes npm copy the package into
# node_modules/hermes-parser instead, so requires resolve through this
# directory's node_modules as expected. See
# external/hermes-parser-native/README.md, "Limitations".
install-links=true
